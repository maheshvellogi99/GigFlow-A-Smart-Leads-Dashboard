# ============================================================
# GigFlow Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Server
NODE_ENV=development
PORT=5001

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gigflow?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# Admin Secret (required for Admin registration)
ADMIN_SECRET=your_admin_secret_key_change_this

# Frontend URL (for CORS — comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173
